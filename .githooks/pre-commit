#!/usr/bin/env bash
# Pre-commit hook: check CSS version bump on staged CSS files.
# Installed by: git config core.hooksPath .githooks
set -euo pipefail

rc=0
ok()   { printf '[pre-commit] ok:   %s\n' "$*"; }
fail() { printf '[pre-commit] FAIL: %s\n' "$*"; rc=1; }
skip() { printf '[pre-commit] skip: %s\n' "$*"; }

staged_css=$(git diff --cached --name-only | grep '\.css$' || true)

if [[ -z "$staged_css" ]]; then
    skip "no CSS files staged — version bump not required"
    exit 0
fi

# CSS is staged — verify version comment was bumped vs HEAD
for f in $staged_css; do
    old_ver=$(git show HEAD:"$f" 2>/dev/null | grep -o 'v: [0-9: -]*' | head -1 || true)
    new_ver=$(grep -o 'v: [0-9: -]*' "$f" | head -1 || true)
    if [[ "$old_ver" == "$new_ver" ]]; then
        fail "$f changed but /* v: */ not bumped (still: $new_ver)"
        printf '         Fix: sed -i "s|/\\* v: .* \\*/|/* v: $(date '"'"'+%%Y-%%m-%%d %%H:%%M'"'"') */|" %s\n' "$f" >&2
        rc=1
    else
        ok "$f: version bumped ($old_ver → $new_ver)"
    fi
done

[[ $rc -ne 0 ]] && exit $rc

# Verify all HTML files are staged with the updated ?v= query string
total_html=$(find . -name "*.html" -not -path "./.git/*" | wc -l)
staged_html=$(git diff --cached --name-only | grep '\.html$' | wc -l)
if [[ "$staged_html" -lt "$total_html" ]]; then
    fail "CSS changed but only ${staged_html}/${total_html} HTML files staged"
    printf '         Fix: VER=$(date +%%Y%%m%%d%%H%%M)\n' >&2
    printf '              find . -name "*.html" -not -path "./.git/*" | xargs sed -i "s|style\\.css?v=[0-9]*|style.css?v=$$VER|g"\n' >&2
    printf '              git add $(find . -name "*.html" -not -path "./.git/*")\n' >&2
    rc=1
else
    ok "all ${total_html} HTML files staged with updated ?v= string"
fi

if [[ $rc -eq 0 ]]; then
    printf '[pre-commit] all checks passed\n'
else
    printf '[pre-commit] commit blocked — fix the issues above\n'
fi
exit $rc
